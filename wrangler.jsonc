{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-knowledge-lab",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-21",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local",
    "AI_GATEWAY_ID": "knowledge-lab",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knowledge-lab-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "knowledge-lab-documents" }],
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "knowledge-lab-index" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "knowledge-lab-ingest" }],
    "consumers": [
      {
        "queue": "knowledge-lab-ingest",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "knowledge-lab-ingest-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_LIMITER", "class_name": "ChatLimiter" }]
  },
  "exports": {
    "ChatLimiter": { "type": "durable-object", "storage": "sqlite" }
  }
}